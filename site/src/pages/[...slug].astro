---
import type { MarkdownInstance } from "astro";
import Layout from "../Layout.astro";
import { pages } from "../links.mjs";
import CrashReplay from "../CrashReplay.astro";

export async function getStaticPaths() {
  const files = import.meta.glob<MarkdownInstance<Record<string, unknown>>>(
    ["../../../docs/guide/**/*.md"],
  );
  return Promise.all(pages.map(async ({ source, path: route }) => {
    const page = await files[`../../../${source}`]();
    const headings = await page.getHeadings();
    return {
      params: { slug: route.replace(/\/$/, "") || undefined },
      props: { Content: page.Content, title: headings[0]?.text || "PyBEAM", headings, source },
    };
  }));
}
const { Content, title, headings, source } = Astro.props;
---
<Layout title={title} headings={headings} source={source}>
  <Content />
  {source === "docs/guide/crash-test.md" && <CrashReplay />}
</Layout>
