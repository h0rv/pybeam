---
import type { MarkdownHeading } from "astro";
import { withBase, repositoryURL, navigationSections } from "./links.mjs";
import styles from "./style.css?url";
import GithubIcon from "./GithubIcon.astro";
import TableOfContents from "./TableOfContents.astro";
import { buildToc } from "./toc.mjs";

interface Props {
  title: string;
  headings: MarkdownHeading[];
  source: string;
}
const { title, headings, source } = Astro.props;
const base = import.meta.env.BASE_URL;
const sections = buildToc(headings);
const home = source === "docs/guide/home.md";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <style is:inline>html{color-scheme:light dark;background:light-dark(#ffffff,#171b24);color:light-dark(#171d2b,#f0f3f9)}body{margin:0}</style>
    <meta name="description" content="Actors, shared state and messaging for async Python, without locks or extra infrastructure." />
    <title>{title === "PyBEAM" ? title : `${title} · PyBEAM`}</title>
    <link rel="stylesheet" href={styles} />
    <link rel="icon" type="image/svg+xml" media="(prefers-color-scheme: light)" href={withBase("brand/pybeam-favicon-light.svg", base)} />
    <link rel="icon" type="image/svg+xml" media="(prefers-color-scheme: dark)" href={withBase("brand/pybeam-favicon-dark.svg", base)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={withBase("", base)} aria-current={home ? "page" : undefined}>
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset={withBase("brand/pybeam-wordmark-dark.svg", base)} />
            <img src={withBase("brand/pybeam-wordmark-light.svg", base)} width="152" height="51" alt="PyBEAM" />
          </picture>
        </a>
        <nav aria-label="Project">
          <a class="project-link" href={withBase("get-started/", base)} aria-label="Get started">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 5c-3-2-7-2-10-1v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Zm0 0v15"/></svg>
            <span class="header-label">Get started</span>
          </a>
          <a class="project-link" href={repositoryURL} aria-label="GitHub"><GithubIcon /><span class="header-label">GitHub</span></a>
          <a class="project-link" href={`${repositoryURL}/blob/main/${source}`} aria-label="Page source">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 2H6v20h12V6Zm0 0v5h4M9 12h6m-6 4h6"/></svg>
            <span class="header-label">Page source</span>
          </a>
        </nav>
      </div>
    </header>
    <div class={home ? "home-layout" : "docs-layout"}>
      {!home && <details class="sidebar">
        <summary>Browse documentation</summary>
        <nav class="docs-nav" aria-label="Documentation">
          {navigationSections.map(({ label, pages }) => <section class="nav-group">
            <h2 class="nav-title">{label}</h2>
            <ul>{pages.map(({ label, path }) => <li>
              <a href={withBase(path, base)} aria-current={Astro.url.pathname === withBase(path, base) ? "page" : undefined}>{label}</a>
            </li>)}</ul>
          </section>)}
        </nav>
      </details>}
      <main id="content">
        <article>
          {home && <picture class="home-mark">
            <source media="(prefers-color-scheme: dark)" srcset={withBase("brand/pybeam-mark-dark.svg", base)} />
            <img src={withBase("brand/pybeam-mark-light.svg", base)} width="96" height="96" alt="" />
          </picture>}
          <slot />
        </article>
      </main>
      {!home && sections.length > 0 && <aside class="page-toc" aria-label="On this page">
        <p class="nav-title">On this page</p>
        <nav><TableOfContents items={sections} /></nav>
      </aside>}
    </div>
    <span class="visually-hidden" id="copy-status" role="status" aria-live="polite"></span>
    <script src="./copy-code.js"></script>
  </body>
</html>
