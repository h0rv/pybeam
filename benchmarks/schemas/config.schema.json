      "type": "array"
    },
    "workload": {
      "$ref": "#/$defs/Workload",
      "default": {
        "id": "rooms.local",
        "entities": 16,
        "events": 1000,
        "warmup_events": 100,
        "seed": 1,
        "activity": "uniform",
        "queue_capacity": 16,
        "queue_bound_scope": "destination_queue",
        "max_inflight": 16,
        "ack": "applied",
        "delivery": "exactly_once_no_retry",
        "payload": {
          "batch_size": 1,
          "encoded_bytes": 1,
          "encoding": "json-utf8",
          "kind": "scalar"
        }
      }
    },
    "budget": {
      "$ref": "#/$defs/Budget",
      "default": {
        "wall_seconds": 15.0,
        "tree_rss_bytes": 536870912,
        "processes": 8,
        "threads": 32,
        "artifact_bytes": 16777216,
        "sample_seconds": 0.02,
        "cpu_cores_requested": 1
      }
