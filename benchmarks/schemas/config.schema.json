          "maximum": 128,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "artifact_bytes": {
          "$ref": "#/$defs/Positive",
          "default": 16777216
        },
        "sample_seconds": {
          "default": 0.02,
          "maximum": 1,
          "minimum": 0.01,
          "title": "Sample Seconds",
          "type": "number"
        },
        "cpu_cores_requested": {
