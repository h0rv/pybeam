{deps, [
    {erlang_python, {git, "https://github.com/h0rv/erlang-python.git",
                     {branch, "mvp/native-channel-receive"}}}
]}.

%% Override dependency hooks at the project boundary, even for older sources.
%% Native tools' explicit -j overrides MAKEFLAGS and CMake's environment.
{overrides, [
    {override, iommap, [{post_hooks, [
        {"(linux|darwin|solaris|freebsd|netbsd|openbsd)", compile,
         "sh -c 'jobs=${CMAKE_BUILD_PARALLEL_LEVEL:-2}; case $jobs in 1|2) ;; *) echo \"CMAKE_BUILD_PARALLEL_LEVEL must be 1 or 2\" >&2; exit 2;; esac; if [ -n \"$IOMMAP_BUILDOPTS\" ]; then echo \"IOMMAP_BUILDOPTS replaced by the compiler job budget\" >&2; fi; ./do_iommap.sh -j \"$jobs\"'"}
    ]}]},
    {override, erlang_python, [{post_hooks, [
        {"(linux|darwin|solaris|freebsd|netbsd|openbsd)", compile,
         "sh -c 'jobs=${CMAKE_BUILD_PARALLEL_LEVEL:-2}; case $jobs in 1|2) ;; *) echo \"CMAKE_BUILD_PARALLEL_LEVEL must be 1 or 2\" >&2; exit 2;; esac; ./do_build.sh -j \"$jobs\"'"}
    ]}]}
]}.

{profiles, [
    {hornbeam, [
        {deps, [
            {hornbeam, {git, "https://github.com/h0rv/hornbeam.git",
                        {branch, "mvp/runtime-support"}}}
        ]}
    ]}
]}.

{shell, [{apps, [erlang_python]}]}.
