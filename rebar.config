{deps, [
    {erlang_python, {git, "https://github.com/h0rv/erlang-python.git",
                     {ref, "5ac2614610aabcae04c444d52e6b6f7065c46e1c"}}}
]}.

%% Override dependency hooks at the project boundary, even for older sources.
%% Native tools' explicit -j overrides MAKEFLAGS and CMake's environment.
%% Configure and build each clear recursive make controls in child scope only.
{overrides, [
    {override, iommap, [
        {pre_hooks, [
            {clean, "rm -f priv/*.so"},
            {clean, "rm -rf _build/cmake"},
            {"(linux|darwin|solaris|freebsd|netbsd|openbsd)", compile,
             "sh -c 'if [ -n \"${MAKEFLAGS+x}${MFLAGS+x}${GNUMAKEFLAGS+x}${MAKEOVERRIDES+x}${MAKEFILES+x}${MAKE+x}${MAKELEVEL+x}\" ]; then echo \"Inherited make controls replaced by the compiler job budget\" >&2; fi; unset MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKEOVERRIDES MAKEFILES MAKE MAKELEVEL; jobs=${CMAKE_BUILD_PARALLEL_LEVEL:-2}; case $jobs in 1|2) ;; *) echo \"CMAKE_BUILD_PARALLEL_LEVEL must be 1 or 2\" >&2; exit 2;; esac; export CMAKE_BUILD_PARALLEL_LEVEL=$jobs; ./do_cmake.sh $IOMMAP_OPTS'"}
        ]},
        {post_hooks, [
            {"(linux|darwin|solaris|freebsd|netbsd|openbsd)", compile,
             "sh -c 'if [ -n \"${MAKEFLAGS+x}${MFLAGS+x}${GNUMAKEFLAGS+x}${MAKEOVERRIDES+x}${MAKEFILES+x}${MAKE+x}${MAKELEVEL+x}\" ]; then echo \"Inherited make controls replaced by the compiler job budget\" >&2; fi; unset MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKEOVERRIDES MAKEFILES MAKE MAKELEVEL; jobs=${CMAKE_BUILD_PARALLEL_LEVEL:-2}; case $jobs in 1|2) ;; *) echo \"CMAKE_BUILD_PARALLEL_LEVEL must be 1 or 2\" >&2; exit 2;; esac; if [ -n \"$IOMMAP_BUILDOPTS\" ]; then echo \"IOMMAP_BUILDOPTS replaced by the compiler job budget\" >&2; fi; ./do_iommap.sh -j \"$jobs\"'"}
        ]}
    ]},
    {override, erlang_python, [
        {pre_hooks, [
            {clean, "rm -f priv/*.so"},
            {clean, "rm -rf _build/cmake"},
            {"(linux|darwin|solaris|freebsd|netbsd|openbsd)", compile,
             "sh -c 'if [ -n \"${MAKEFLAGS+x}${MFLAGS+x}${GNUMAKEFLAGS+x}${MAKEOVERRIDES+x}${MAKEFILES+x}${MAKE+x}${MAKELEVEL+x}\" ]; then echo \"Inherited make controls replaced by the compiler job budget\" >&2; fi; unset MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKEOVERRIDES MAKEFILES MAKE MAKELEVEL; jobs=${CMAKE_BUILD_PARALLEL_LEVEL:-2}; case $jobs in 1|2) ;; *) echo \"CMAKE_BUILD_PARALLEL_LEVEL must be 1 or 2\" >&2; exit 2;; esac; export CMAKE_BUILD_PARALLEL_LEVEL=$jobs; ./do_cmake.sh ${PYBEAM_BUILD_PYTHON:+\"-DPython3_EXECUTABLE=$PYBEAM_BUILD_PYTHON\"} ${PYBEAM_BUILD_ABI:+\"-DPython3_FIND_ABI=$PYBEAM_BUILD_ABI\"}'"}
        ]},
        {post_hooks, [
            {"(linux|darwin|solaris|freebsd|netbsd|openbsd)", compile,
             "sh -c 'if [ -n \"${MAKEFLAGS+x}${MFLAGS+x}${GNUMAKEFLAGS+x}${MAKEOVERRIDES+x}${MAKEFILES+x}${MAKE+x}${MAKELEVEL+x}\" ]; then echo \"Inherited make controls replaced by the compiler job budget\" >&2; fi; unset MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKEOVERRIDES MAKEFILES MAKE MAKELEVEL; jobs=${CMAKE_BUILD_PARALLEL_LEVEL:-2}; case $jobs in 1|2) ;; *) echo \"CMAKE_BUILD_PARALLEL_LEVEL must be 1 or 2\" >&2; exit 2;; esac; ./do_build.sh -j \"$jobs\"'"}
        ]}
    ]}
]}.

{profiles, [
    {hornbeam, [
        {deps, [
            {hornbeam, {git, "https://github.com/h0rv/hornbeam.git",
                        {ref, "d3b7850aacad81145b5d9d314dbe27e367cdcdc5"}}}
        ]}
    ]}
]}.

{shell, [{apps, [erlang_python]}]}.
