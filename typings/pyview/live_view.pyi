from pyview.events import InfoEvent
from pyview.live_socket import ConnectedLiveViewSocket, LiveViewSocket
from pyview.meta import PyViewMeta
from pyview.template import RenderedContent

type Session = dict[str, object]

class LiveView[T]:
    def __init__(self) -> None: ...
    async def mount(self, socket: LiveViewSocket[T], session: Session) -> None: ...
    async def handle_info(self, event: InfoEvent, socket: ConnectedLiveViewSocket[T]) -> None: ...
    async def disconnect(self, socket: ConnectedLiveViewSocket[T]) -> None: ...
    async def render(self, assigns: T, meta: PyViewMeta) -> RenderedContent: ...
