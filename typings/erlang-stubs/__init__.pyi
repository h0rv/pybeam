import asyncio

from erlang import actors as actors
from erlang import supervision as supervision
from erlang import tasks as tasks

class ErlangEventLoop(asyncio.AbstractEventLoop):
    def __init__(self, capsule: object = None) -> None: ...

def new_event_loop() -> ErlangEventLoop: ...
async def async_call(name: str, *args: object) -> object: ...
def _actor_retain(value: object, /) -> object: ...
def _actor_unwrap(reference: object, /) -> object: ...
def send(pid: object, message: object) -> None: ...

class ChannelClosed(Exception): ...

class Channel:
    def __init__(self, resource: object) -> None: ...
    async def async_receive(self, *, native_only: bool = False) -> object: ...
    def close(self) -> None: ...
