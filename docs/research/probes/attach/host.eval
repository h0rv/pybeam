application:load(erlang_python),
application:set_env(erlang_python, num_contexts, 2),
application:set_env(erlang_python, event_loop_pool_size, 1),
{ok, Started} = application:ensure_all_started(erlang_python),
io:format("host node=~p started=~p py_launch=~p~n", [node(), Started, code:is_loaded(py_launch)]),
Ctx = py:context(1),
ok = py_context:exec(Ctx, <<"import os, sys; sys.path[:0] = os.environ['PYTHONPATH'].split(':')">>),
ok = py_context:exec(Ctx, <<"import attach_probe">>),
ok = py_context:start_loop(Ctx),
{ok, Channel} = py_channel:new(#{max_size => 4096, max_messages => 4}),
ok = py_channel:send(Channel, <<"host-to-python">>),
Result = py_context:submit_await(Ctx, attach_probe, main, [self(), Channel], #{}, 30000),
io:format("probe=~p~n", [Result]),
{ok, #{<<"actors">> := <<"12 then 15; group closed">>,
       <<"tasks">> := <<"42; supervisor closed">>}} = Result,
receive
    {<<"python-to-host">>, <<"host-to-python">>} -> io:format("host received Python reply: ok~n")
after 5000 -> error(python_reply_timeout)
end,
io:format("host still alive after Python returned: ~p~n", [is_process_alive(self())]),
ok = py_context:stop_loop(Ctx),
ok = application:load(hornbeam),
{ok, Sup} = hornbeam_sup:start_link(),
ok = py:register_function(hornbeam_services, hornbeam_services, callback),
ok = py_context:start_loop(Ctx),
Services = py_context:submit_await(Ctx, attach_probe, services, [], #{}, 10000),
io:format("services after host starts Hornbeam=~p~n", [Services]),
{ok, <<"counter=1">>} = Services,
ok = gen_server:stop(Sup),
ok = py:unregister_function(hornbeam_services),
ok = py_context:stop_loop(Ctx),
ok = application:stop(erlang_python),
io:format("host still alive after erlang_python stop: ~p~n", [is_process_alive(self())]),
halt(0).
